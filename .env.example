# Copier ce fichier en .env.local pour tester en local. Sur Vercel : Settings → Environment Variables.
# Rien de secret ne doit être mis dans le code ni dans git.

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://patrimoine-app.vercel.app

# Supabase (comptes utilisateurs + base de données) — supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (abonnements) — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix créés dans Stripe (Produits → Plus / Pro, mensuel et annuel)
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Powens (connexion bancaire) — console.powens.com
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Cours de bourse en secours (facultatif : Tradegate et Yahoo fonctionnent sans clé)
TWELVE_DATA_API_KEY=
